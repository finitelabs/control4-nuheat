<devicedata>
  <name>Nuheat</name>
  <version/>
  <manufacturer>Finite Labs</manufacturer>
  <model>Nuheat Signature / Conductor</model>
  <creator>Derek Miller</creator>
  <small image_source="c4z">icons/device_sm.png</small>
  <large image_source="c4z">icons/device_lg.png</large>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 Finite Labs, LLC. All rights reserved.</copyright>
  <created>10/23/2026 12:00:00 PM</created>
  <modified/>
  <combo>true</combo>
  <minimum_os_version>3.3.0</minimum_os_version>
  <composer_categories>
    <category>Comfort</category>
  </composer_categories>
  <events>
    <event>
      <id>1</id>
      <name>Account Linked</name>
      <description>When NAME is linked to a Nuheat account, or links again after losing its sign-in</description>
    </event>
    <event>
      <id>2</id>
      <name>Account Not Linked</name>
      <description>When NAME loses its Nuheat sign-in or is unlinked</description>
    </event>
  </events>
  <conditionals>
    <conditional>
      <id>1</id>
      <name>ACCOUNT_LINKED</name>
      <type>BOOL</type>
      <condition_statement>Nuheat account link status</condition_statement>
      <description>NAME account is STRING</description>
      <true_text>Linked</true_text>
      <false_text>Not Linked</false_text>
    </conditional>
  </conditionals>
  <config>
    <script file="driver.lua" jit="1"/>
    <documentation file="www/documentation/index.html"/>
    <properties>
      <property>
        <name>Cloud</name>
        <type>LABEL</type>
        <default>Cloud Settings</default>
      </property>
      <!-- #ifdef DRIVERCENTRAL -->
      <property>
        <name>Cloud Status</name>
        <default/>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <!-- #endif -->
      <property>
        <name>Automatic Updates</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>On</default>
      </property>
      <!-- #ifndef DRIVERCENTRAL -->
      <property>
        <name>Update Channel</name>
        <type>LIST</type>
        <default>Production</default>
        <items>
          <item>Production</item>
          <item>Prerelease</item>
        </items>
      </property>
      <!-- #endif -->
      <property>
        <name>Account Settings</name>
        <type>LABEL</type>
        <default>Account Settings</default>
      </property>
      <property>
        <name>Account Status</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Authentication URL</name>
        <type>STRING</type>
        <default/>
        <readonly>false</readonly>
      </property>
      <property>
        <name>Driver</name>
        <type>LABEL</type>
        <default>Driver Settings</default>
      </property>
      <property>
        <name>Driver Status</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Log Level</name>
        <type>LIST</type>
        <default>3 - Info</default>
        <items>
          <item>0 - Fatal</item>
          <item>1 - Error</item>
          <item>2 - Warning</item>
          <item>3 - Info</item>
          <item>4 - Debug</item>
          <item>5 - Trace</item>
          <item>6 - Ultra</item>
        </items>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
      </property>
      <!-- #ifdef DRIVERCENTRAL -->
      <property>
        <name>Support Code</name>
        <type>STRING</type>
        <default/>
        <description>Enter only a code from Finite Labs support. It opens the Lua window for an hour.</description>
        <password>true</password>
      </property>
      <!-- #endif -->
      <property>
        <name>Nuheat</name>
        <type>LABEL</type>
        <default>Nuheat Settings</default>
      </property>
      <property>
        <name>Poll Interval</name>
        <type>LIST</type>
        <default>60 seconds</default>
        <items>
          <item>30 seconds</item>
          <item>60 seconds</item>
          <item>120 seconds</item>
          <item>300 seconds</item>
        </items>
      </property>
    </properties>
    <actions>
      <!-- #ifndef DRIVERCENTRAL -->
      <action>
        <name>Update Drivers</name>
        <command>Update_Drivers</command>
      </action>
      <!-- #endif -->
      <action>
        <name>Link Account</name>
        <command>Link_Account</command>
      </action>
      <action>
        <name>Unlink Account</name>
        <command>Unlink_Account</command>
      </action>
      <action>
        <name>Add Thermostats</name>
        <command>Add_Thermostats</command>
      </action>
      <action>
        <name>Refresh Thermostats</name>
        <command>Refresh_Thermostats</command>
      </action>
      <action>
        <name>Reset Driver</name>
        <command>Reset_Driver</command>
        <params>
          <param>
            <name>Are You Sure?</name>
            <type>LIST</type>
            <items>
              <item>No</item>
              <item>Yes</item>
            </items>
          </param>
        </params>
      </action>
    </actions>
    <commands>
      <command>
        <name>Refresh Thermostats</name>
        <description>Refresh thermostats on NAME</description>
      </command>
    </commands>
  </config>
  <connections/>
</devicedata>
