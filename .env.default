# Build secrets. tools/preprocess.py substitutes each __NAME__ placeholder in the
# build with its value from the environment, a gitignored .env (cp .env.default
# .env and fill it in) or the macOS Keychain. CI passes each from the repository's
# Actions secret of the same name: list one the template does not already pass in
# extra_build_secrets (CONTRIBUTING.md, Build Secrets).

# Opens the Lua window of a DriverCentral build for support (CONTRIBUTING.md, The Support Code).
SUPPORT_CODE_SECRET=

# The support phone number a DriverCentral build's Support section gives, as +1-NNN-NNN-NNNN (CONTRIBUTING.md, Build Secrets).
SUPPORT_PHONE=

# The support email address a DriverCentral build's docs give (CONTRIBUTING.md, Build Secrets).
SUPPORT_EMAIL=

# Cloud Monitoring's InfluxDB origin, write-only token and databases (CONTRIBUTING.md, Cloud Monitoring).
INFLUXDB_URL=
INFLUXDB_TOKEN=
INFLUXDB_METRICS_DB=
INFLUXDB_LOGS_DB=

# OAuth client ID for the Nuheat OpenAPI, issued by Chemelex Applications
# Engineering. A public client with PKCE, so it has no secret. Its redirect URIs
# are Control4's production and development callbacks.
NUHEAT_CLIENT_ID=

# API keys for Control4's OAuth redirect service and short-link service, issued by
# Control4. The development and production servers take different keys.
C4_OAUTH_API_KEY=
C4_LINK_API_KEY=

# "true" uses Control4's production redirect and short-link servers, "false" the
# development ones. Set "true" with the production keys. Leave it set either way:
# a release build fails on an empty value.
C4_OAUTH_PRODUCTION=
