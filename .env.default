# Build secrets. tools/preprocess.py substitutes each __NAME__ placeholder in the
# build with its value from the environment or a gitignored .env (cp .env.default
# .env and fill it in). CI takes them from the repository's Actions secrets.

# OAuth client Chemelex issues for the Nuheat OpenAPI (Patrick Hendrickx,
# Applications Engineering). A public client with PKCE, so it has no secret. Its
# redirect URIs are Control4's production and development callbacks.
NUHEAT_CLIENT_ID=

# Control4 OAuth redirect service and short-link API keys (Will Walsh at Control4
# issues them). Development and production servers take different keys.
C4_OAUTH_API_KEY=
C4_LINK_API_KEY=
# "true" uses Control4's production redirect and short-link servers, "false" the
# development ones. Set "true" with the production keys. Leave it set either way:
# a release build fails on an empty value.
C4_OAUTH_PRODUCTION=
# Opens the Lua window of a DriverCentral build for support (CONTRIBUTING.md, The Support Code).
SUPPORT_CODE_SECRET=
