# Build secrets. tools/preprocess.py substitutes each __NAME__ placeholder in the
# build with its value from the environment or a gitignored .env (cp .env.default
# .env and fill it in). CI takes them from the repository's Actions secrets.

# OAuth client Chemelex issues for the Nuheat OpenAPI (Patrick Hendrickx,
# Applications Engineering). Its redirect URIs are Control4's production and
# development callbacks.
NUHEAT_CLIENT_ID=
NUHEAT_CLIENT_SECRET=

# Control4 OAuth redirect service and short-link API keys (Will Walsh at Control4
# issues them). Development and production servers take different keys.
C4_OAUTH_API_KEY=
C4_LINK_API_KEY=
# "true" uses Control4's production redirect and short-link servers; anything
# else uses the development ones. Set it with the production keys.
C4_OAUTH_PRODUCTION=
